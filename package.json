{
  "name": "pt-booking",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "config": "node scripts/generate-environment.mjs",
    "prestart": "npm run config",
    "start": "ng serve --host 0.0.0.0",
    "prebuild": "npm run config",
    "build": "ng build",
    "typecheck": "npm run config && ngc -p tsconfig.app.json --noEmit && tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node --test tests/database.integration.mjs",
    "test:auth": "node --env-file-if-exists=.env --test tests/auth.integration.mjs",
    "test:e2e": "playwright test",
    "db:start": "node scripts/supabase.mjs start -x studio,imgproxy,storage-api,realtime,edge-runtime,logflare,vector,supavisor",
    "db:stop": "node scripts/supabase.mjs stop",
    "db:reset": "node scripts/supabase.mjs db reset --local",
    "demo:seed": "node --env-file-if-exists=.env scripts/seed-demo.mjs",
    "native:sync": "npm run build && cap sync",
    "native:android": "npm run native:sync && cap open android",
    "native:ios": "npm run native:sync && cap open ios",
    "db:configure": "node scripts/configure-local.mjs",
    "check:local": "node scripts/check-local.mjs"
  },
  "dependencies": {
    "@angular/animations": "20.3.34",
    "@angular/common": "20.3.34",
    "@angular/compiler": "20.3.34",
    "@angular/core": "20.3.34",
    "@angular/forms": "20.3.34",
    "@angular/platform-browser": "20.3.34",
    "@angular/router": "20.3.34",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@ionic/angular": "8.8.19",
    "@js-temporal/polyfill": "^0.5.1",
    "@supabase/supabase-js": "^2.95.0",
    "ionicons": "^8.0.13",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.33",
    "@angular/cli": "20.3.33",
    "@angular/compiler-cli": "20.3.34",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "8.5.3",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.0",
    "pg": "^8.16.3",
    "supabase": "2.121.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.50.0",
    "vitest": "^3.2.4"
  }
}
